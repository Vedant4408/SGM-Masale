# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# RAZORPAY CREDENTIALS (Optional for Test Mode Simulator; Required for Live/Gateway Mode)
# Configure these in your deployment environment secrets before switching to Live Mode.
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# ADMIN ACCESS EMAILS (Comma-separated list of Google emails granted automatic Admin privileges)
ADMIN_EMAILS="jejurkarvedant44@gmail.com"
